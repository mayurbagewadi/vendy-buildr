{
  "name": "ai-theme-worker",
  "version": "1.0.0",
  "description": "Standalone background worker for Build Theme AI page generation. Runs on the VPS, outside any HTTP request path — never behind Cloudflare/nginx.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:built": "node dist/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "@types/node": "^22.5.5"
  }
}
