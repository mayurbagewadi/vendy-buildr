# Copy to .env on the VPS. Never commit the real .env — service role key
# has full DB access, bypassing RLS.

SUPABASE_URL=https://vexeuxsvckpfvuxqchqu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Max concurrent OpenRouter calls across ALL stores at once. This is the
# real production knob — size it to your OpenRouter rate limit and VPS
# capacity, not to how many stores you have. Each in-flight call is an idle
# outbound HTTPS request, so this is cheap on CPU/RAM even at 20-30.
AI_WORKER_CONCURRENCY=6

# How often to poll for new queued jobs when idle (ms).
AI_WORKER_POLL_INTERVAL_MS=1500

# Lease duration per job attempt (seconds). Must comfortably exceed the
# slowest realistic single-page generation + one repair retry.
AI_WORKER_LEASE_SECONDS=240

# Per-call OpenRouter timeout (seconds). Shorter than the lease so a hung
# call gets classified as a timeout and retried, rather than silently
# holding a slot until the lease expires and the reaper cleans it up.
AI_WORKER_CALL_TIMEOUT_SECONDS=180

# Unique name for this worker process — shows up in job.lease_owner for
# debugging which worker/host handled a job. Include hostname + pid so two
# workers on the same box never collide.
AI_WORKER_NAME=vps-worker-1
